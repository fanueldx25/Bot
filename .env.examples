# ============================================================================
# 🔐 AUTHENTICATION
# ============================================================================

# Control panel login password (REQUIRED)
ADMIN_PASSWORD=your_strong_password_here

# Secret used to sign auth cookies (auto-generated if not set, but setting it
# keeps you logged in across redeploys)
SESSION_SECRET=generate_a_random_64_char_string_here


# ============================================================================
# 💓 SELF-PING (keeps Render free tier awake)
# ============================================================================

# Your Render app's public URL — no trailing slash
# Example: https://my-wa-bot.onrender.com
SELF_URL=https://your-app-name.onrender.com


# ============================================================================
# 🌤️ WEATHER (free key at https://openweathermap.org/api)
# ============================================================================

WEATHER_API_KEY=your_openweathermap_api_key


# ============================================================================
# 🖼️ IMAGE HOSTING (free key at https://api.imgbb.com/)
# ============================================================================

IMGBB_API_KEY=your_imgbb_api_key


# ============================================================================
# 🎨 BANNER (optional — URL to a hardcoded default banner image)
# ============================================================================

DEFAULT_BANNER_URL=https://i.imgur.com/yourbanner.jpg


# ============================================================================
# 💾 STORAGE (Render-specific)
# ============================================================================

# Set to "true" ONLY if you attached a Render persistent disk at /data
# Leave empty or omit for free tier (uses /tmp, which wipes on redeploy)
PERSISTENT_DISK=false


# ============================================================================
# 🌍 RUNTIME (Render sets these automatically — don't set manually)
# ============================================================================

# RENDER=true
# PORT=3000
# NODE_ENV=production