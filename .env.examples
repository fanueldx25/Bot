# ============================================================================
# .env.example — template for local development and reference
# ============================================================================
# Copy this file to `.env` and fill in real values for local dev.
# On Render, set the same variables in the service's Environment tab.
#
# Never commit a real .env file. Only this example.
# ============================================================================


# ----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ----------------------------------------------------------------------------

# Dashboard login password. If unset, the dashboard is PUBLIC and anyone
# can pair/disconnect/delete the bot session. Set a strong random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASHBOARD_PASSWORD=change-me-to-something-strong


# ----------------------------------------------------------------------------
# ADMIN / OWNER
# ----------------------------------------------------------------------------

# The primary admin's phone number. Digits only, no +, no spaces.
# This number gets unrestricted access to admin commands (.restart, .pair,
# .status, .antimention action, etc.).
ADMIN_NUMBER=237651858408

# Additional admin phone numbers, comma-separated. Digits only.
# Use for co-admins who should also have admin command access.
EXTRA_ADMINS=237651858408


# ----------------------------------------------------------------------------
# LID → PN MAPPING (fixes DM replies on newer WhatsApp accounts)
# ----------------------------------------------------------------------------
# WhatsApp now delivers DMs from some accounts with an @lid (linked-device
# identifier) as the sender JID. The bot cannot reply to unmapped @lids —
# messages silently drop (typing shows, reply never arrives).
#
# Format: lid:phone,lid:phone,...
# Get the lid from the bot's terminal log — you'll see a line like:
# [LID] DM cannot be routed — reply would silently fail.
# remoteJid = 232057586356242@lid
# Copy the digits before @lid, and pair it with that person's real phone.
LID_MAP=232057586356242:237651858408


# ----------------------------------------------------------------------------
# SESSION CODE SECRET
# ----------------------------------------------------------------------------
# HMAC secret used by the dashboard's rotating "reconnect code". Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, falls back to 'default-session-secret' which is INSECURE.
SESSION_SECRET=change-me-to-a-long-random-string


# ----------------------------------------------------------------------------
# SERVER / NETWORKING
# ----------------------------------------------------------------------------

# Port the server binds to. Render sets this automatically; only set for
# local dev.
# PORT=3000

# Set to 'production' on Render. Enables Secure cookie flag when the
# dashboard runs behind HTTPS.
NODE_ENV=production

# Force Secure cookie even if NODE_ENV isn't 'production'. Use when you
# run behind a reverse proxy with HTTPS in a non-prod environment.
# COOKIE_SECURE=1

# Public URL of this service. Used by the self-ping keep-alive to prevent
# Render's free tier from sleeping after 15 minutes of inactivity.
SELF_URL=https://bot-6d65.onrender.com

# CORS origin allowed to reach the dashboard from a browser. Set this to
# your dashboard's real origin in production; '*' is dev-only.
# Leave unset on Render to fall back to '*' (works, but lock it down later).
# DASHBOARD_ORIGIN=https://bot-6d65.onrender.com


# ----------------------------------------------------------------------------
# OPTIONAL — WHATSAPP PAIRING
# ----------------------------------------------------------------------------

# Comma-separated JIDs that should receive view-once captures (the .vv
# feature and the automatic VO capture). If unset, VO capture uses
# ADMIN_NUMBER.
# VO_TARGETS=237651858408@s.whatsapp.net

# Name shown in WhatsApp as the linked device. Cosmetic only.
# DEVICE_NAME=Fanuels Bot


# ----------------------------------------------------------------------------
# OPTIONAL — RUNTIME TUNING
# ----------------------------------------------------------------------------

# Force @resvg/resvg-js and sharp to use prebuilt binaries instead of
# looking for system libvips. Set this on Render if sharp fails to load.
# SHARP_IGNORE_GLOBAL_LIBVIPS=1

# Node environment warnings and faster shutdowns.
# NODE_OPTIONS=--max-old-space-size=512