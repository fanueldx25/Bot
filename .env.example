# ==========================================
# Fanuel WhatsApp Bot - Environment Variables Example
# ==========================================

# 1. Gemini AI API Key (Used for AI commands and smart features)
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Application Public URL (Used for self-referential links, temp downloads, and self-ping keep-alive)
APP_URL="https://your-app-name.onrender.com"

# 3. PostgreSQL Database Connection String (Supabase, Neon, Render PostgreSQL, or local Postgres)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# 4. Master Passkey for Dashboard Security (Required to unlock the admin dashboard UI)
DASHBOARD_PASSWORD="your_secure_master_passkey_here"

# 5. Server Port (Defaults to 3000)
PORT=3000
